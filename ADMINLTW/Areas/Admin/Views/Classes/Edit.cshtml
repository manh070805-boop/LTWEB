@model TrungTamLapTrinh.Web.Areas.Admin.ViewModels.CenterClassFormViewModel

@{
    ViewData["Title"] = "Sửa lớp học";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Cập nhật lớp học</h1>
        <p>Chỉnh sửa thông tin và cấu hình lớp</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Quay lại
    </a>
</div>

<div class="edit-grid">
    <div class="edit-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Cấu hình lớp học</div>
                <span class="badge badge-neutral">Mã lớp: @Model.ClassId</span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClassId" />
                    <div asp-validation-summary="All" class="validation-summary"></div>

                    <div class="form-group">
                        <label asp-for="ClassName" class="form-label">Tên lớp học</label>
                        <input asp-for="ClassName" class="form-control" placeholder="Ví dụ: Lớp ReactJS - K24..." />
                        <span asp-validation-for="ClassName" class="form-error"></span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="CourseId" class="form-label">Thuộc khóa học</label>
                            <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId">
                                <option value="">-- Chọn khóa học --</option>
                            </select>
                            <span asp-validation-for="CourseId" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TeacherId" class="form-label">Giảng viên phụ trách</label>
                            <select asp-for="TeacherId" class="form-select" asp-items="ViewBag.TeacherId">
                                <option value="">-- Chọn giảng viên --</option>
                            </select>
                            <span asp-validation-for="TeacherId" class="form-error"></span>
                        </div>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="StatusId" class="form-label">Trạng thái vận hành</label>
                            <select asp-for="StatusId" class="form-select" asp-items="ViewBag.StatusId">
                                <option value="">-- Chọn trạng thái --</option>
                            </select>
                            <span asp-validation-for="StatusId" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="RoomName" class="form-label">Phòng học / Link Meet</label>
                            <input asp-for="RoomName" class="form-control" placeholder="Ví dụ: P.301 hoặc Zoom ID..." />
                            <span asp-validation-for="RoomName" class="form-error"></span>
                        </div>
                    </div>

                    <div class="grid-3">
                        <div class="form-group">
                            <label asp-for="StartDate" class="form-label">Ngày khai giảng</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="MaxStudents" class="form-label">Sĩ số tối đa</label>
                            <input asp-for="MaxStudents" type="number" class="form-control" />
                            <span asp-validation-for="MaxStudents" class="form-error"></span>
                        </div>
                    </div>

                    <div style="display:flex;gap:.75rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                            </svg>
                            Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="edit-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Quản lý vận hành</div>
            </div>
            <div class="card-body">
                <ul class="guide-list">
                    <li>
                        <strong>Trạng thái:</strong> Lớp học ở trạng thái <em>"Sắp khai giảng"</em> mới có thể nhận đăng ký mới từ học viên.
                    </li>
                    <li>
                        <strong>Sĩ số:</strong> Hệ thống sẽ tự động khóa đăng ký khi số lượng học viên đạt mức <em>Sĩ số tối đa</em>.
                    </li>
                    <li>
                        <strong>Thời gian:</strong> Hãy đảm bảo ngày kết thúc sau ngày khai giảng để tránh sai lệch dữ liệu lịch học.
                    </li>
                </ul>
            </div>
        </div>

        <div class="card mt-4" style="background: var(--primary-50); border-color: var(--primary-100);">
            <div class="card-body">
                <div style="display:flex; gap:1rem; align-items:flex-start;">
                    <div style="font-size:1.5rem;">📅</div>
                    <div>
                        <h4 style="margin:0 0 .25rem 0; font-size:.875rem; color:var(--primary-700);">Lịch học chi tiết</h4>
                        <p style="margin:0; font-size:.8125rem; color:var(--primary-600); line-height:1.4;">
                            Để quản lý các buổi học cụ thể, hãy truy cập trang <a asp-action="Details" asp-route-id="@Model.ClassId" style="color:var(--primary-700); font-weight:600;">Chi tiết lớp học</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .edit-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .guide-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .guide-list li {
        font-size: .875rem;
        color: var(--text-600);
        line-height: 1.5;
        position: relative;
        padding-left: 1.25rem;
    }

    .guide-list li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--primary);
        font-weight: bold;
    }

    .guide-list li strong {
        color: var(--text-900);
        display: block;
        margin-bottom: .125rem;
    }

    @@media (max-width: 1024px) {
        .edit-grid { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
