@model TrungTamLapTrinh.Web.Models.Account

@{
    ViewData["Title"] = "Chi tiết tài khoản";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Chi tiết tài khoản</h1>
        <p>ID: <span class="td-mono">#@Model.AccountId</span> • @Model.Role?.RoleName</p>
    </div>
    <div style="display:flex;gap:.625rem;">
        <a asp-action="Edit" asp-route-id="@Model.AccountId" class="btn btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Quay lại
        </a>
    </div>
</div>

<div class="details-grid">
    <!-- Left Column: Primary Info -->
    <div class="details-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Thông tin cơ bản</div>
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge badge-danger">Đã khóa</span>
                }
            </div>
            <div class="card-body">
                <div class="info-grid-modern">
                    <div class="info-item-modern">
                        <label>Họ và tên</label>
                        <div class="value">@Model.FullName</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Tên đăng nhập</label>
                        <div class="value td-mono">@Model.Username</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Email liên hệ</label>
                        <div class="value">@Model.Email</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Vai trò hệ thống</label>
                        <div class="value">
                            <span class="badge badge-neutral">@Model.Role?.RoleName</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <div class="card-title">Nhật ký tài khoản</div>
            </div>
            <div class="card-body">
                <div class="timeline-simple">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="timeline-label">Tài khoản được khởi tạo</div>
                        </div>
                    </div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="timeline-item">
                            <div class="timeline-dot warning"></div>
                            <div class="timeline-content">
                                <div class="timeline-date">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="timeline-label">Cập nhật thông tin gần nhất</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Sidebar Actions & Context -->
    <div class="details-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Hành động</div>
            </div>
            <div class="card-body">
                <form asp-action="ToggleActive" asp-route-id="@Model.AccountId" method="post" style="margin-bottom: .75rem;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-success")" style="width:100%; justify-content:center;">
                        @(Model.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
                    </button>
                </form>
                <a href="#" class="btn btn-outline" style="width:100%; justify-content:center; text-decoration:none;">
                    Đặt lại mật khẩu
                </a>
            </div>
        </div>

        @if (Model.Student != null || Model.Teacher != null)
        {
            <div class="card mt-4">
                <div class="card-header">
                    <div class="card-title">Hồ sơ liên kết</div>
                </div>
                <div class="card-body">
                    @if (Model.Student != null)
                    {
                        <div class="profile-link-card">
                            <div class="profile-avatar">S</div>
                            <div class="profile-info">
                                <strong>Học viên</strong>
                                <span>Mã số: #@Model.Student.StudentId</span>
                            </div>
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@Model.Student.StudentId" class="btn btn-sm btn-info">Chi tiết</a>
                        </div>
                    }
                    @if (Model.Teacher != null)
                    {
                        <div class="profile-link-card">
                            <div class="profile-avatar teacher">T</div>
                            <div class="profile-info">
                                <strong>Giảng viên</strong>
                                <span>Mã số: @Model.Teacher.TeacherId</span>
                            </div>
                            <a asp-controller="Teachers" asp-action="Details" asp-route-id="@Model.Teacher.TeacherId" class="btn btn-sm btn-info">Chi tiết</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .details-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 1.5rem;
    }

    .info-grid-modern {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .info-item-modern label {
        display: block;
        font-size: .6875rem;
        font-weight: 600;
        color: var(--text-400);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .375rem;
    }

    .info-item-modern .value {
        font-size: .9375rem;
        color: var(--text-900);
        font-weight: 500;
    }

    /* Timeline Styles */
    .timeline-simple {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: relative;
        padding-left: 1.25rem;
    }

    .timeline-simple::before {
        content: '';
        position: absolute;
        left: 3px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--border-light);
    }

    .timeline-item {
        position: relative;
    }

    .timeline-dot {
        position: absolute;
        left: -1.25rem;
        top: 5px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--primary);
        border: 2px solid var(--surface);
        z-index: 1;
    }

    .timeline-dot.warning { background: var(--warning); }

    .timeline-date {
        font-size: .75rem;
        color: var(--text-400);
        margin-bottom: .125rem;
    }

    .timeline-label {
        font-size: .875rem;
        color: var(--text-700);
        font-weight: 500;
    }

    /* Profile Link Card */
    .profile-link-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: .75rem;
        background: var(--bg);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
    }

    .profile-avatar {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: var(--primary-100);
        color: var(--primary-700);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .profile-avatar.teacher {
        background: var(--success-100);
        color: var(--success-700);
    }

    .profile-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .profile-info strong {
        font-size: .875rem;
        color: var(--text-900);
    }

    .profile-info span {
        font-size: .75rem;
        color: var(--text-500);
    }

    .btn-outline {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-700);
        font-size: .8125rem;
        font-weight: 600;
    }

    .btn-outline:hover {
        background: var(--bg);
    }

    @@media (max-width: 1024px) {
        .details-grid { grid-template-columns: 1fr; }
        .info-grid-modern { grid-template-columns: 1fr; }
    }
</style>