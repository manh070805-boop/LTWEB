@model IEnumerable<TrungTamLapTrinh.Web.Models.Account>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<!-- Page header -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Danh sách tài khoản</h1>
        <p>Quản lý toàn bộ tài khoản trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Thêm tài khoản
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px">
            <polyline points="20 6 9 17 4 12"/>
        </svg>
        @TempData["SuccessMessage"]
    </div>
}

<!-- Table -->
<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Quyền</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th style="width:220px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="td-mono">@item.AccountId</td>
                    <td style="font-weight:500;color:var(--text-900);">@item.Username</td>
                    <td>@item.FullName</td>
                    <td class="text-muted">@item.Email</td>
                    <td>
                        <span class="badge badge-neutral">@item.Role?.RoleName</span>
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge badge-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Đã khóa</span>
                        }
                    </td>
                    <td class="text-muted text-sm">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <div style="display:flex;gap:.375rem;flex-wrap:wrap;">
                            <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-info btn-sm">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.AccountId" class="btn btn-danger btn-sm">Xóa</a>

                            <form asp-action="ToggleActive" asp-route-id="@item.AccountId" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                @if (item.IsActive)
                                {
                                    <button type="submit" class="btn btn-secondary btn-sm">Khóa</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-success btn-sm">Mở</button>
                                }
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" style="text-align:center;padding:3rem;color:var(--text-400);">
                        Chưa có tài khoản nào
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>