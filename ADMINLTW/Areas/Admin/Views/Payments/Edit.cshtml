@model TrungTamLapTrinh.Web.Areas.Admin.ViewModels.PaymentFormViewModel

@{
    ViewData["Title"] = "Sửa thanh toán";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Cập nhật thanh toán</h1>
        <p>Chỉnh sửa thông tin giao dịch</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Quay lại
    </a>
</div>

<div class="edit-grid">
    <div class="edit-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Chi tiết giao dịch</div>
                <span class="badge badge-neutral">Mã phiếu thu: @Model.PaymentId</span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PaymentId" />
                    <div asp-validation-summary="All" class="validation-summary"></div>

                    <div class="form-group">
                        <label asp-for="EnrollmentId" class="form-label">Đơn ghi danh liên kết</label>
                        <select asp-for="EnrollmentId" class="form-select" asp-items="ViewBag.EnrollmentId">
                            <option value="">-- Chọn đơn ghi danh --</option>
                        </select>
                        <span asp-validation-for="EnrollmentId" class="form-error"></span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Amount" class="form-label">Số tiền thanh toán</label>
                            <div style="position:relative;">
                                <input asp-for="Amount" type="number" step="1000" class="form-control" style="padding-right:3.5rem;" />
                                <span style="position:absolute;right:.875rem;top:50%;transform:translateY(-50%);color:var(--text-400);font-size:.8125rem;pointer-events:none;">VNĐ</span>
                            </div>
                            <span asp-validation-for="Amount" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TransactionNo" class="form-label">Mã giao dịch (Banking/POS)</label>
                            <input asp-for="TransactionNo" class="form-control" placeholder="Ví dụ: VNP12345678..." />
                            <span asp-validation-for="TransactionNo" class="form-error"></span>
                        </div>
                    </div>

                    <div class="grid-3">
                        <div class="form-group">
                            <label asp-for="MethodId" class="form-label">Phương thức</label>
                            <select asp-for="MethodId" class="form-select" asp-items="ViewBag.MethodId">
                                <option value="">-- Phương thức --</option>
                            </select>
                            <span asp-validation-for="MethodId" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="StatusId" class="form-label">Trạng thái</label>
                            <select asp-for="StatusId" class="form-select" asp-items="ViewBag.StatusId">
                                <option value="">-- Trạng thái --</option>
                            </select>
                            <span asp-validation-for="StatusId" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PaidAt" class="form-label">Ngày thanh toán</label>
                            <input asp-for="PaidAt" type="datetime-local" class="form-control" />
                            <span asp-validation-for="PaidAt" class="form-error"></span>
                        </div>
                    </div>

                    <div style="display:flex;gap:.75rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                            </svg>
                            Cập nhật giao dịch
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="edit-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Chính sách tài chính</div>
            </div>
            <div class="card-body">
                <ul class="guide-list">
                    <li>
                        <strong>Đối soát:</strong> Mã giao dịch (Transaction No) là thông tin quan trọng nhất để đối soát với sao kê ngân hàng.
                    </li>
                    <li>
                        <strong>Học phí:</strong> Hãy đảm bảo số tiền khớp với học phí niêm yết của khóa học trừ đi các khuyến mãi (nếu có).
                    </li>
                    <li>
                        <strong>Thời gian:</strong> Ngày thanh toán nên được ghi nhận đúng thời điểm tiền về tài khoản trung tâm.
                    </li>
                </ul>
            </div>
        </div>

        <div class="card mt-4" style="background: var(--primary-50); border-color: var(--primary-100);">
            <div class="card-body">
                <div style="display:flex; gap:1rem; align-items:flex-start;">
                    <div style="font-size:1.5rem;">📜</div>
                    <div>
                        <h4 style="margin:0 0 .25rem 0; font-size:.875rem; color:var(--primary-700);">Chứng từ liên quan</h4>
                        <p style="margin:0; font-size:.8125rem; color:var(--primary-600); line-height:1.4;">
                            Bạn có thể xuất biên lai thu tiền sau khi giao dịch được chuyển sang trạng thái <strong>"Thành công"</strong>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .edit-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .guide-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .guide-list li {
        font-size: .875rem;
        color: var(--text-600);
        line-height: 1.5;
        position: relative;
        padding-left: 1.25rem;
    }

    .guide-list li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--primary);
        font-weight: bold;
    }

    .guide-list li strong {
        color: var(--text-900);
        display: block;
        margin-bottom: .125rem;
    }

    @@media (max-width: 1024px) {
        .edit-grid { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
