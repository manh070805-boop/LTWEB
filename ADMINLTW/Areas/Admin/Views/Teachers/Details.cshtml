@model TrungTamLapTrinh.Web.Models.Teacher

@{
    ViewData["Title"] = "Chi tiết giảng viên";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Hồ sơ giảng viên</h1>
        <p>@Model.Account?.FullName • Chuyên gia: <span class="badge badge-info">@Model.Specialization</span></p>
    </div>
    <div style="display:flex;gap:.625rem;">
        <a asp-action="Edit" asp-route-id="@Model.TeacherId" class="btn btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Quay lại
        </a>
    </div>
</div>

<div class="details-grid">
    <div class="details-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Thông tin giảng viên</div>
            </div>
            <div class="card-body">
                <div class="info-grid-modern">
                    <div class="info-item-modern">
                        <label>Mã giảng viên</label>
                        <div class="value td-mono">#@Model.TeacherId</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Họ và tên</label>
                        <div class="value">@Model.Account?.FullName</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Email</label>
                        <div class="value">@Model.Account?.Email</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Số điện thoại</label>
                        <div class="value">@Model.Phone</div>
                    </div>
                    <div class="info-item-modern" style="grid-column: span 2;">
                        <label>Chuyên môn</label>
                        <div class="value">@Model.Specialization</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <div style="margin-top:2rem; padding-top:1.5rem; border-top:1px solid var(--border);">
                        <label style="display:block; font-size:.6875rem; font-weight:600; color:var(--text-400); text-transform:uppercase; margin-bottom:.75rem;">Giới thiệu / Tiểu sử</label>
                        <div style="color:var(--text-700); line-height:1.7; font-size:.9375rem; white-space:pre-line;">@Model.Bio</div>
                    </div>
                }
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <div class="card-title">Các lớp đang phụ trách</div>
                <span class="badge badge-neutral">@Model.CenterClasses.Count lớp học</span>
            </div>
            <div class="card-body" style="padding:0;">
                <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Tên lớp</th>
                                <th>Khóa học</th>
                                <th>Ngày bắt đầu</th>
                                <th>Sĩ số</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cls in Model.CenterClasses)
                            {
                                <tr>
                                    <td><strong>@cls.ClassName</strong></td>
                                    <td>@cls.Course?.CourseName</td>
                                    <td class="text-sm">@(cls.StartDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>
                                        <span class="badge badge-neutral">0 học viên</span> <!-- This would need a Count property if available -->
                                    </td>
                                    <td>
                                        <a asp-controller="Classes" asp-action="Details" asp-route-id="@cls.ClassId" class="btn-icon" title="Chi tiết lớp">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.CenterClasses.Any())
                            {
                                <tr>
                                    <td colspan="5" style="text-align:center;padding:2.5rem;color:var(--text-400);">Giảng viên này chưa được phân công lớp học nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="details-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Tài khoản liên kết</div>
            </div>
            <div class="card-body">
                <div class="account-status-card">
                    <div class="status-indicator @(Model.Account?.IsActive == true ? "active" : "inactive")"></div>
                    <div class="status-info">
                        <strong>@(Model.Account?.IsActive == true ? "Đang hoạt động" : "Tạm khóa")</strong>
                        <span>@@@Model.Account?.Username</span>
                    </div>
                </div>
                <div style="margin-top:1rem; display:flex; flex-direction:column; gap:.5rem;">
                    <a asp-controller="Accounts" asp-action="Details" asp-route-id="@Model.AccountId" class="btn btn-outline" style="justify-content:center; text-decoration:none;">
                        Cài đặt bảo mật
                    </a>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <div class="card-title">Chỉ số giảng dạy</div>
            </div>
            <div class="card-body">
                <div class="quick-stats-list">
                    <div class="quick-stat-item">
                        <div class="stat-icon" style="background:var(--primary-50);">👨‍🏫</div>
                        <div class="stat-info">
                            <label>Tổng số lớp học</label>
                            <div class="stat-value">@Model.CenterClasses.Count</div>
                        </div>
                    </div>
                    <div class="quick-stat-item">
                        <div class="stat-icon" style="background:var(--success-50);">✅</div>
                        <div class="stat-info">
                            <label>Trạng thái</label>
                            <div class="stat-value" style="font-size:.875rem; color:var(--success);">Sẵn sàng dạy</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .details-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
    }

    .info-grid-modern {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .info-item-modern label {
        display: block;
        font-size: .6875rem;
        font-weight: 600;
        color: var(--text-400);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .375rem;
    }

    .info-item-modern .value {
        font-size: .9375rem;
        color: var(--text-900);
        font-weight: 500;
    }

    /* Account Status Card */
    .account-status-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--bg);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
    }

    .status-indicator {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }
    .status-indicator.active { background: var(--success); box-shadow: 0 0 0 4px var(--success-100); }
    .status-indicator.inactive { background: var(--danger); box-shadow: 0 0 0 4px var(--danger-100); }

    .status-info strong {
        display: block;
        font-size: .875rem;
        color: var(--text-900);
    }

    .status-info span {
        font-size: .75rem;
        color: var(--text-500);
    }

    /* Quick Stats */
    .quick-stats-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .quick-stat-item {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .stat-icon {
        font-size: 1.25rem;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }

    .stat-info label {
        display: block;
        font-size: .75rem;
        color: var(--text-500);
        margin-bottom: 2px;
    }

    .stat-value {
        font-size: 1.0625rem;
        font-weight: 700;
        color: var(--text-900);
    }

    .btn-outline {
        background: white;
        border: 1px solid var(--border);
        color: var(--text-700);
        font-size: .8125rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .625rem 1rem;
        border-radius: var(--radius-sm);
        transition: all .2s;
    }

    .btn-outline:hover {
        background: var(--bg);
        border-color: var(--text-300);
    }

    @@media (max-width: 1024px) {
        .details-grid { grid-template-columns: 1fr; }
        .info-grid-modern { grid-template-columns: 1fr; }
    }
</style>