@model TrungTamLapTrinh.Web.Areas.Admin.ViewModels.StudentFormViewModel

@{
    ViewData["Title"] = "Sửa học viên";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Cập nhật học viên</h1>
        <p>Chỉnh sửa thông tin hồ sơ</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Quay lại
    </a>
</div>

<div class="edit-grid">
    <div class="edit-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Thông tin hồ sơ</div>
                <span class="badge badge-neutral">Mã học viên: @Model.StudentId</span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="StudentId" />

                    <div asp-validation-summary="All" class="validation-summary"></div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label class="form-label">Tài khoản liên kết</label>
                            <select asp-for="AccountId" class="form-select" asp-items="ViewBag.AccountId">
                                <option value="">-- Chọn tài khoản --</option>
                            </select>
                            <span asp-validation-for="AccountId" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Phone" class="form-label">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                            <span asp-validation-for="Phone" class="form-error"></span>
                        </div>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Birthday" class="form-label">Ngày sinh</label>
                            <input asp-for="Birthday" type="date" class="form-control" />
                            <span asp-validation-for="Birthday" class="form-error"></span>
                        </div>
                        <div class="form-group">
                             <label class="form-label">ID Hồ sơ (Readonly)</label>
                             <input value="@Model.StudentId" class="form-control" readonly style="background-color: var(--bg-100); cursor: not-allowed;" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address" class="form-label">Địa chỉ thường trú</label>
                        <textarea asp-for="Address" class="form-control" rows="4" placeholder="Nhập địa chỉ đầy đủ..."></textarea>
                        <span asp-validation-for="Address" class="form-error"></span>
                    </div>

                    <div style="display:flex;gap:.75rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                            </svg>
                            Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="edit-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Hướng dẫn</div>
            </div>
            <div class="card-body">
                <ul class="guide-list">
                    <li>
                        <strong>Tài khoản:</strong> Liên kết hồ sơ học viên với một tài khoản người dùng có quyền "Student".
                    </li>
                    <li>
                        <strong>Liên hệ:</strong> Đảm bảo số điện thoại chính xác để nhận thông báo về lịch học và học phí.
                    </li>
                    <li>
                        <strong>Bảo mật:</strong> Mọi thay đổi sẽ được ghi lại trong hệ thống nhật ký quản trị.
                    </li>
                </ul>
            </div>
        </div>

        <div class="card mt-4" style="background: var(--primary-50); border-color: var(--primary-100);">
            <div class="card-body">
                <div style="display:flex; gap:1rem; align-items:flex-start;">
                    <div style="font-size:1.5rem;">💡</div>
                    <div>
                        <h4 style="margin:0 0 .25rem 0; font-size:.875rem; color:var(--primary-700);">Mẹo nhỏ</h4>
                        <p style="margin:0; font-size:.8125rem; color:var(--primary-600); line-height:1.4;">
                            Bạn có thể xem chi tiết quá trình học tập của học viên này tại trang <a asp-action="Details" asp-route-id="@Model.StudentId" style="color:var(--primary-700); font-weight:600;">Chi tiết hồ sơ</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .edit-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .guide-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .guide-list li {
        font-size: .875rem;
        color: var(--text-600);
        line-height: 1.5;
        position: relative;
        padding-left: 1.25rem;
    }

    .guide-list li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--primary);
        font-weight: bold;
    }

    .guide-list li strong {
        color: var(--text-900);
        display: block;
        margin-bottom: .125rem;
    }

    @@media (max-width: 1024px) {
        .edit-grid { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
