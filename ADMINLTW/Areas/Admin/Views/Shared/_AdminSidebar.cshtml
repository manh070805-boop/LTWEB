@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavCls(string name) =>
        ctrl.Equals(name, StringComparison.OrdinalIgnoreCase)
            ? "sidebar-nav-item active"
            : "sidebar-nav-item";
}

<!-- Brand -->
<div class="sidebar-brand">
    <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
        </svg>
    </div>
    <span class="sidebar-brand-name">TTLT Admin</span>
</div>

<!-- User info -->
<div class="sidebar-user">
    <div class="sidebar-user-name">@Context.Session.GetString("FullName")</div>
    <div class="sidebar-user-role">@Context.Session.GetString("Role")</div>
</div>

<!-- Navigation -->
<nav class="sidebar-nav">

    <div class="sidebar-nav-section">Tổng quan</div>

    <a class="@NavCls("Dashboard")"
       asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        Dashboard
    </a>

    <div class="sidebar-nav-section">Quản lý người dùng</div>

    <a class="@NavCls("Accounts")"
       asp-area="Admin" asp-controller="Accounts" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
        Tài khoản
    </a>

    <a class="@NavCls("Students")"
       asp-area="Admin" asp-controller="Students" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Học viên
    </a>

    <a class="@NavCls("Teachers")"
       asp-area="Admin" asp-controller="Teachers" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            <path d="M9 12l-3 8 6-3 6 3-3-8"/>
        </svg>
        Giảng viên
    </a>

    <div class="sidebar-nav-section">Đào tạo</div>

    <a class="@NavCls("Courses")"
       asp-area="Admin" asp-controller="Courses" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        Khóa học
    </a>

    <a class="@NavCls("Classes")"
       asp-area="Admin" asp-controller="Classes" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Lớp học
    </a>


    <a class="@NavCls("Schedules")"
       asp-area="Admin" asp-controller="Schedules" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        Lịch học
    </a>

    <div class="sidebar-nav-section">Tài chính</div>

    <a class="@NavCls("Enrollments")"
       asp-area="Admin" asp-controller="Enrollments" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
        </svg>
        Đăng ký học
    </a>

    <a class="@NavCls("Payments")"
       asp-area="Admin" asp-controller="Payments" asp-action="Index">
        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
            <line x1="1" y1="10" x2="23" y2="10"/>
        </svg>
        Thanh toán
    </a>

</nav>

<!-- Footer / Logout -->
<div class="sidebar-footer">
    <a asp-controller="Account" asp-action="Logout" class="btn btn-danger w-full">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Đăng xuất
    </a>
</div>
