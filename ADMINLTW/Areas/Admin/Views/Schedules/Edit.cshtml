@model TrungTamLapTrinh.Web.Areas.Admin.ViewModels.ScheduleFormViewModel

@{
    ViewData["Title"] = "Sửa lịch học";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Cập nhật lịch học</h1>
        <p>Chỉnh sửa thời khóa biểu</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Quay lại
    </a>
</div>

<div class="edit-grid">
    <div class="edit-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Cấu hình thời gian học</div>
                <span class="badge badge-neutral">Mã lịch: @Model.ScheduleId</span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ScheduleId" />
                    <div asp-validation-summary="All" class="validation-summary"></div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="ClassId" class="form-label">Lớp học áp dụng</label>
                            <select asp-for="ClassId" class="form-select" asp-items="ViewBag.ClassId">
                                <option value="">-- Chọn lớp học --</option>
                            </select>
                            <span asp-validation-for="ClassId" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DayOfWeek" class="form-label">Ngày trong tuần</label>
                            <select asp-for="DayOfWeek" class="form-select">
                                <option value="">-- Chọn thứ --</option>
                                <option value="1">Thứ Hai</option>
                                <option value="2">Thứ Ba</option>
                                <option value="3">Thứ Tư</option>
                                <option value="4">Thứ Năm</option>
                                <option value="5">Thứ Sáu</option>
                                <option value="6">Thứ Bảy</option>
                                <option value="0">Chủ Nhật</option>
                            </select>
                            <span asp-validation-for="DayOfWeek" class="form-error"></span>
                        </div>
                    </div>

                    <div class="grid-3">
                        <div class="form-group">
                            <label asp-for="StartTime" class="form-label">Giờ bắt đầu</label>
                            <input asp-for="StartTime" type="time" class="form-control" />
                            <span asp-validation-for="StartTime" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="EndTime" class="form-label">Giờ kết thúc</label>
                            <input asp-for="EndTime" type="time" class="form-control" />
                            <span asp-validation-for="EndTime" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="RoomName" class="form-label">Phòng học</label>
                            <input asp-for="RoomName" class="form-control" placeholder="Ví dụ: P.202..." />
                            <span asp-validation-for="RoomName" class="form-error"></span>
                        </div>
                    </div>

                    <div style="display:flex;gap:.75rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                            </svg>
                            Cập nhật lịch học
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="edit-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Nguyên tắc xếp lịch</div>
            </div>
            <div class="card-body">
                <ul class="guide-list">
                    <li>
                        <strong>Trùng lịch:</strong> Hãy kiểm tra kỹ xem phòng học hoặc giảng viên có bị trùng lịch vào khung giờ này không.
                    </li>
                    <li>
                        <strong>Thời gian:</strong> Thời lượng một buổi học tiêu chuẩn thường kéo dài từ 90 đến 120 phút.
                    </li>
                    <li>
                        <strong>Phòng học:</strong> Nếu học trực tuyến, hãy nhập đường dẫn Zoom/Meet vào ô "Phòng học".
                    </li>
                </ul>
            </div>
        </div>

        <div class="card mt-4" style="background: var(--primary-50); border-color: var(--primary-100);">
            <div class="card-body">
                <div style="display:flex; gap:1rem; align-items:flex-start;">
                    <div style="font-size:1.5rem;">📅</div>
                    <div>
                        <h4 style="margin:0 0 .25rem 0; font-size:.875rem; color:var(--primary-700);">Tổng quan lớp</h4>
                        <p style="margin:0; font-size:.8125rem; color:var(--primary-600); line-height:1.4;">
                            Bạn có thể xem toàn bộ thời khóa biểu của lớp này tại trang <a href="#" style="color:var(--primary-700); font-weight:600;">Chi tiết lớp học</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .edit-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .guide-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .guide-list li {
        font-size: .875rem;
        color: var(--text-600);
        line-height: 1.5;
        position: relative;
        padding-left: 1.25rem;
    }

    .guide-list li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--primary);
        font-weight: bold;
    }

    .guide-list li strong {
        color: var(--text-900);
        display: block;
        margin-bottom: .125rem;
    }

    @@media (max-width: 1024px) {
        .edit-grid { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
