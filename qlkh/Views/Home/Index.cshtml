@{
    ViewData["Title"] = "QLKH - Nền tảng học lập trình chuyên nghiệp";
}

<link rel="stylesheet" href="~/css/home-index.css" />

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-content">
                    <h1 class="hero-title">
                        Chinh phục lập trình cùng các chuyên gia
                    </h1>
                    <p class="hero-subtitle">
                        Học các kỹ năng lập trình thực tế từ các giảng viên giàu kinh nghiệm. Dự án thực tế, mentor 1-1, và chứng chỉ uy tín chờ bạn.
                    </p>
                    <div class="hero-buttons">
                        <a asp-controller="Course" asp-action="Index" class="btn-hero btn-hero-primary">
                            Khám phá khóa học
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn-hero btn-hero-secondary">
                            Đăng ký miễn phí
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="feature-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Tại sao chọn TMMDEV?</h2>
            <p class="section-subtitle">Ba lợi ích chính giúp bạn thành công</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        💻
                    </div>
                    <h3>Dự án thực tế</h3>
                    <p>
                        Làm việc với các dự án thực tế từ các công ty hàng đầu. Xây dựng portfolio mạnh mẽ chứng minh kỹ năng của bạn.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        🤝
                    </div>
                    <h3>Hỗ trợ Mentor 1-1</h3>
                    <p>
                        Được hướng dẫn cá nhân hóa từ các mentors chuyên gia. Giải đáp thắc mắc nhanh chóng và nhận lời khuyên có giá trị.
                    </p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        🏆
                    </div>
                    <h3>Chứng chỉ uy tín</h3>
                    <p>
                        Nhận chứng chỉ quốc tế được công nhận. Tăng giá trị hồ sơ ứng tuyển và tự tin trong phỏng vấn xin việc.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

