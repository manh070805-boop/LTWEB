@{
    ViewData["Title"] = "Đăng Nhập - QLKH";
}

<link rel="stylesheet" href="~/css/account-auth.css" />

<div class="auth-container">
    <!-- LEFT SIDE: ILLUSTRATION -->
    <div class="auth-left">
        <div class="auth-left-content">
            <div class="auth-logo">
                Dev<span>Academy</span>
            </div>

            <div class="auth-illustration">
                <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
                    <rect x="20" y="40" width="360" height="220" rx="15" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
                    <rect x="20" y="40" width="360" height="40" rx="15" fill="rgba(255,255,255,0.1)"/>
                    <circle cx="45" cy="60" r="4" fill="#ef4444"/>
                    <circle cx="60" cy="60" r="4" fill="#f59e0b"/>
                    <circle cx="75" cy="60" r="4" fill="#10b981"/>

                    <text x="40" y="100" font-size="12" fill="rgba(255,255,255,0.6)" font-family="monospace">function learnCode() {</text>
                    <text x="60" y="120" font-size="12" fill="rgba(255,255,255,0.7)" font-family="monospace">const skill = "expert";</text>
                    <text x="60" y="140" font-size="12" fill="rgba(255,255,255,0.7)" font-family="monospace">return success();</text>
                    <text x="40" y="160" font-size="12" fill="rgba(255,255,255,0.6)" font-family="monospace">}</text>

                    <rect x="120" y="160" width="2" height="15" fill="rgba(255,255,255,0.8)"/>
                </svg>
            </div>

            <h2 class="auth-slogan">
                Học lập trình thực chiến cùng chuyên gia
            </h2>
            <p class="auth-description">
                Khóa học được thiết kế bởi các lập trình viên senior có kinh nghiệm thực tế từ các công ty công nghệ hàng đầu. Hơn 5000+ học viên đã thành công.
            </p>
        </div>
    </div>

    <!-- RIGHT SIDE: LOGIN FORM -->
    <div class="auth-right">
        <div class="auth-form-card">
            <div class="auth-form-header">
                <h1>Chào mừng trở lại</h1>
                <p>Đăng nhập để tiếp tục hành trình học tập của bạn</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" style="margin-bottom: 16px;">
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-controller="Account" asp-action="Login">
                <!-- Username -->
                <div class="auth-form-group">
                    <label class="auth-form-label">Username</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon">👤</span>
                        <input type="text"
                               class="auth-form-input"
                               placeholder="Nhập username"
                               name="username"
                               required />
                    </div>
                </div>

                <!-- Password -->
                <div class="auth-form-group">
                    <label class="auth-form-label">Mật khẩu</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon">🔐</span>
                        <input type="password"
                               class="auth-form-input"
                               id="passwordInput"
                               placeholder="Nhập mật khẩu"
                               name="password"
                               required />
                        <button type="button"
                                class="auth-password-toggle"
                                onclick="togglePassword(event)">
                            👁️
                        </button>
                    </div>
                </div>

                <!-- Remember & Forgot -->
                <div class="auth-form-controls">
                    <label class="auth-checkbox">
                        <input type="checkbox" name="rememberMe" />
                        <span>Ghi nhớ tôi</span>
                    </label>
                    <a href="#" class="auth-forgot-link">Quên mật khẩu?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-btn-submit">
                    Đăng nhập
                </button>
            </form>

            <!-- Google Login -->
            <button type="button" class="auth-btn-google" onclick="loginWithGoogle()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Đăng nhập bằng Google
            </button>

            <!-- Divider -->
            <div class="auth-divider">hoặc</div>

            <!-- Footer Link -->
            <div class="auth-form-footer">
                Chưa có tài khoản?
                <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword(event) {
        const input = document.getElementById('passwordInput');
        const btn = event.currentTarget;

        if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = '🙈';
        } else {
            input.type = 'password';
            btn.textContent = '👁️';
        }
    }

    function loginWithGoogle() {
        alert('Google login sẽ được tích hợp sau.');
    }
</script>