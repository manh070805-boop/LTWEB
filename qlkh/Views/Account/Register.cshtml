@{
    ViewData["Title"] = "Đăng Ký - QLKH";
}

<link rel="stylesheet" href="~/css/account-auth.css" />

<div class="auth-container">
    <!-- LEFT SIDE: ILLUSTRATION -->
    <div class="auth-left">
        <div class="auth-left-content">
            <div class="auth-logo">
                Dev<span>Academy</span>
            </div>

            <div class="auth-illustration">
                <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
                    <!-- Rocket -->
                    <g transform="translate(200, 80)">
                        <!-- Rocket body -->
                        <ellipse cx="0" cy="0" rx="25" ry="50" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.4)" stroke-width="2"/>
                        
                        <!-- Window -->
                        <circle cx="0" cy="-20" r="12" fill="rgba(255,255,255,0.3)"/>
                        
                        <!-- Flames -->
                        <path d="M -15 35 Q -20 55 -10 65 Q 0 50 10 65 Q 20 55 15 35 Z" fill="rgba(255, 159, 64, 0.4)"/>
                        <path d="M -8 40 Q -12 55 -5 60 Q 0 48 5 60 Q 12 55 8 40 Z" fill="rgba(255, 193, 7, 0.5)"/>
                    </g>

                    <!-- Stars -->
                    <circle cx="80" cy="50" r="3" fill="rgba(255,255,255,0.6)"/>
                    <circle cx="320" cy="80" r="2.5" fill="rgba(255,255,255,0.5)"/>
                    <circle cx="100" cy="150" r="2" fill="rgba(255,255,255,0.4)"/>
                    <circle cx="300" cy="200" r="2.5" fill="rgba(255,255,255,0.5)"/>

                    <!-- Text -->
                    <text x="200" y="200" text-anchor="middle" font-size="14" fill="rgba(255,255,255,0.8)" font-weight="bold">Bắt đầu hành trình</text>
                    <text x="200" y="220" text-anchor="middle" font-size="14" fill="rgba(255,255,255,0.7)">của bạn ngay hôm nay</text>
                </svg>
            </div>

            <h2 class="auth-slogan">
                Tham gia cộng đồng 5000+ học viên thành công
            </h2>
            <p class="auth-description">
                Đăng ký tài khoản miễn phí và nhận quyền truy cập vào tất cả các khóa học, tài liệu và hỗ trợ trực tiếp từ các mentor chuyên gia.
            </p>
        </div>
    </div>

    <!-- RIGHT SIDE: REGISTER FORM -->
    <div class="auth-right">
        <div class="auth-form-card">
            <div class="auth-form-header">
                <h1>Tạo tài khoản</h1>
                <p>Bước đầu tiên để thành công trong lập trình</p>
            </div>

            <form method="post" asp-action="Register">
                <!-- Full Name -->
                <div class="auth-form-group">
                    <label class="auth-form-label">Họ và tên</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon">👤</span>
                        <input type="text" 
                               class="auth-form-input" 
                               placeholder="Nguyễn Văn A" 
                               name="fullName"
                               required />
                    </div>
                </div>

                <!-- Email -->
                <div class="auth-form-group">
                    <label class="auth-form-label">Email</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon">✉️</span>
                        <input type="email" 
                               class="auth-form-input" 
                               placeholder="bạn@example.com" 
                               name="email"
                               required />
                    </div>
                </div>

                <!-- Password -->
                <div class="auth-form-group">
                    <label class="auth-form-label">Mật khẩu</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon">🔐</span>
                        <input type="password" 
                               class="auth-form-input" 
                               id="passwordInput"
                               placeholder="Nhập mật khẩu (tối thiểu 8 ký tự)" 
                               name="password"
                               required />
                        <button type="button" 
                                class="auth-password-toggle" 
                                onclick="togglePassword('passwordInput')">
                            👁️
                        </button>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="auth-form-group">
                    <label class="auth-form-label">Xác nhận mật khẩu</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon">🔐</span>
                        <input type="password" 
                               class="auth-form-input" 
                               id="confirmPasswordInput"
                               placeholder="Nhập lại mật khẩu" 
                               name="confirmPassword"
                               required />
                        <button type="button" 
                                class="auth-password-toggle" 
                                onclick="togglePassword('confirmPasswordInput')">
                            👁️
                        </button>
                    </div>
                </div>

                <!-- Terms & Conditions -->
                <div class="auth-form-group">
                    <label class="auth-checkbox">
                        <input type="checkbox" name="agreeTerms" required />
                        <label>Tôi đồng ý với <a href="#" style="color: #4f46e5;">Điều khoản sử dụng</a> và <a href="#" style="color: #4f46e5;">Chính sách bảo mật</a></label>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-btn-submit">
                    Tạo tài khoản
                </button>
            </form>

            <!-- Google Signup -->
            <button class="auth-btn-google" onclick="signupWithGoogle()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Đăng ký bằng Google
            </button>

            <!-- Divider -->
            <div class="auth-divider">hoặc</div>

            <!-- Footer Link -->
            <div class="auth-form-footer">
                Đã có tài khoản?
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        const btn = event.target;
        
        if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = '👁️‍🗨️';
        } else {
            input.type = 'password';
            btn.textContent = '👁️';
        }
    }

    function signupWithGoogle() {
        alert('Google signup sẽ được tích hợp với Firebase');
    }
</script>
    </div>
</section>
