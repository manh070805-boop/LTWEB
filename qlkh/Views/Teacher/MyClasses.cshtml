@model List<qlkh.Models.CenterClass>

@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Quản lý khóa học";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Quản lý khóa học</h1>
        <p>Các lớp học bạn đang phụ trách giảng dạy và danh sách bài giảng của từng lớp.</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card animate-in" style="text-align: center; padding: 3rem 2rem;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--border-light); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 1.5rem;">
            🏫
        </div>
        <h3 class="font-bold text-sm" style="font-size: 1.15rem; color: var(--text-900); margin-bottom: .375rem;">Bạn chưa được phân công lớp nào</h3>
        <p class="text-muted text-xs" style="font-size: .85rem;">Vui lòng liên hệ với Quản trị viên (Admin) để được gán lớp phụ trách.</p>
    </div>
}
else
{
    <div class="grid-3 animate-in">
        @foreach (var item in Model)
        {
            var courseName = item.Course?.CourseName ?? "Khóa học";
            var statusName = item.Status?.StatusName ?? "Đang diễn ra";
            var statusBadge = "badge-success";
            if (statusName.Contains("Kết thúc") || statusName.Contains("Đóng")) {
                statusBadge = "badge-danger";
            } else if (statusName.Contains("Chưa") || statusName.Contains("Sắp")) {
                statusBadge = "badge-warning";
            }

            <div class="card" style="border-top: 4px solid var(--text-900);">
                <div class="card-header">
                    <div>
                        <span class="badge badge-neutral">ID: @item.ClassId</span>
                    </div>
                    <span class="badge @statusBadge">@statusName</span>
                </div>
                <div class="card-body">
                    <h3 class="font-bold text-sm mb-4" style="font-size: 1.15rem; color: var(--text-900);">@item.ClassName</h3>
                    
                    <div class="flex flex-col gap-2 text-sm text-muted">
                        <div class="flex items-center gap-2">
                            <span style="opacity: 0.7;">📘</span>
                            <span><strong>Khóa học:</strong> @courseName</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span style="opacity: 0.7;">🏫</span>
                            <span><strong>Phòng học:</strong> @(item.RoomName ?? "Online")</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span style="opacity: 0.7;">📅</span>
                            <span><strong>Thời gian:</strong> @(item.StartDate?.ToString("dd/MM/yyyy") ?? "Chưa rõ") — @(item.EndDate?.ToString("dd/MM/yyyy") ?? "Đang mở")</span>
                        </div>
                    </div>

                    <div class="mt-6">
                        <a asp-controller="Teacher"
                           asp-action="Lessons"
                           asp-route-classId="@item.ClassId"
                           class="btn btn-primary w-full" style="justify-content: center;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                            </svg>
                            &nbsp;Quản lý bài học
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
