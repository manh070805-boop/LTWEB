@using System.Net
@model qlkh.Models.Payment

@{
    ViewData["Title"] = "Thanh toán học phí";

    var bankCode = ViewBag.BankCode?.ToString() ?? "";
    var accountNo = ViewBag.AccountNo?.ToString() ?? "";
    var accountNameRaw = ViewBag.AccountName?.ToString() ?? "";
    var contentRaw = ViewBag.Content?.ToString() ?? "";

    var accountName = WebUtility.UrlEncode(accountNameRaw);
    var content = WebUtility.UrlEncode(contentRaw);

    var qrUrl = $"https://img.vietqr.io/image/{bankCode}-{accountNo}-compact2.png" +
                $"?amount={Model.Amount}" +
                $"&addInfo={content}" +
                $"&accountName={accountName}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Thanh toán đăng ký khóa học</h4>
                </div>

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        @(Model.Enrollment != null && Model.Enrollment.Course != null 
                            ? Model.Enrollment.Course.CourseName 
                            : "")
                    </h5>

                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Mã đăng ký:</strong> @Model.EnrollmentId</p>

                            <p>
                                <strong>Số tiền:</strong>
                                @Model.Amount.ToString("N0") VNĐ
                            </p>

                            <p>
                                <strong>Phương thức:</strong>
                                @(Model.Method != null ? Model.Method.MethodName : "")
                            </p>

                            <p>
                                <strong>Trạng thái:</strong>
                                @(Model.Status != null ? Model.Status.StatusName : "")
                            </p>

                            <hr />

                            <p><strong>Ngân hàng:</strong> @bankCode</p>
                            <p><strong>Số tài khoản:</strong> @accountNo</p>
                            <p><strong>Chủ tài khoản:</strong> @accountNameRaw</p>
                            <p><strong>Nội dung CK:</strong> @contentRaw</p>
                        </div>

                        <div class="col-md-6 text-center">
                            <img src="@qrUrl"
                                 class="img-fluid border rounded p-2"
                                 style="max-width: 300px;" />

                            <p class="text-muted mt-3">
                                Quét mã QR để thanh toán học phí.
                            </p>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-4">
                        Sau khi chuyển khoản, bấm nút dưới để xác nhận.
                    </div>

                    <!-- BUTTON -->
                    <button id="btnConfirm"
                            class="btn btn-success w-100 fw-bold">
                        ✅ Tôi đã thanh toán
                    </button>

                    <div class="mt-3 d-flex gap-2">
                        <a asp-controller="Student" asp-action="MyCourses"
                           class="btn btn-outline-primary w-50">
                            Khóa học của tôi
                        </a>

                        <a asp-controller="Course" asp-action="Index"
                           class="btn btn-secondary w-50">
                            Quay lại
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    const btn = document.getElementById("btnConfirm");
    btn.addEventListener("click", function () {

        btn.disabled = true;
        btn.innerText = "Đang gửi...";

        fetch("/Payment/ConfirmPaid", {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: "paymentId=@Model.PaymentId"
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                showToast(d.message, "success");
                btn.innerText = "✔ Đã gửi xác nhận";
            } else {
                showToast(d.message, "error");
                btn.disabled = false;
                btn.innerText = "✅ Tôi đã thanh toán";
            }
        })
        .catch(() => {
            showToast("Lỗi hệ thống", "error");
            btn.disabled = false;
            btn.innerText = "✅ Tôi đã thanh toán";
        });
    });
</script>
}
