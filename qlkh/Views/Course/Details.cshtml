@model  qlkh.Models.Course
@{
    ViewData["Title"] = Model.CourseName;
}

<style>
    .page-hero-sm { background: linear-gradient(135deg, #4f46e5 0%, #7c4dff 100%); color: white; padding: 60px 0; }
    .detail-banner { 
        height: 300px; display: flex; align-items: center; justify-content: center; 
        font-size: 3rem; font-weight: bold; border-radius: 20px; color: white;
        background: #f3f4f6 url('@Model.ImageUrl') center/cover;
    }
    .media-orange { background-color: #ff9800; } /* Fallback màu nếu ko có ảnh */
    .info-pill { background: #f0edff; color: #7c4dff; padding: 5px 15px; border-radius: 50px; font-size: 0.85rem; font-weight: 600; }
    .detail-panel { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-top: 30px; }
    .syllabus-item { display: flex; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid #f1f1f1; pb-3; }
    .syllabus-item span { font-size: 1.5rem; font-weight: 800; color: #e0e0e0; }
    .detail-sidebar { position: sticky; top: 100px; background: white; padding: 25px; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); }
    .price-box strong { font-size: 1.8rem; color: #7c4dff; display: block; margin-bottom: 15px; }
    .btn-accent { background: #7c4dff; color: white; font-weight: 700; border-radius: 12px; padding: 12px; transition: 0.3s; }
    .btn-accent:hover { background: #6333ea; transform: translateY(-2px); }
</style>

<section class="page-hero page-hero-sm mb-5">
    <div class="container text-center">
        <span class="badge bg-white text-primary mb-2">Chi tiết khóa học</span>
        <h1 class="display-4 fw-bold">@Model.CourseName</h1>
        <p class="lead opacity-75">Hệ thống đào tạo lập trình thực chiến TMMDEV</p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="detail-showcase bg-white p-4 rounded-4 shadow-sm">
                    <div class="detail-banner rounded-4 mb-4 shadow-sm">
                        @if(string.IsNullOrEmpty(Model.ImageUrl)) { <span>@Model.CourseId</span> }
                    </div>
                    
                    <div class="detail-copy">
                        <div class="pill-row d-flex gap-2 mb-4">
                            <span class="info-pill"><i class="far fa-clock"></i> @Model.DurationMonths tháng</span>
                            <span class="info-pill"><i class="fas fa-layer-group"></i> Thực chiến</span>
                            <span class="info-pill"><i class="fas fa-certificate"></i> Certificate</span>
                        </div>
                        <h2 class="fw-bold mb-3">Mô tả khóa học</h2>
                        <div class="text-secondary lh-lg">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>
                </div>

                <div class="detail-panel">
                    <h3 class="fw-bold mb-4"><i class="fas fa-list-ul me-2"></i>Lộ trình học tập (Roadmap)</h3>
                    <div class="syllabus-list">
                        @* Giả sử bạn parse Roadmap từ chuỗi hoặc lấy từ bảng Lesson *@
                        <div class="text-secondary">
                             @Html.Raw(Model.Roadmap)
                        </div>
                        
                        @* Nếu bạn muốn dùng style Syllabus số thứ tự như mẫu *@
                        <div class="mt-4">
                            <div class="syllabus-item">
                                <span>01</span>
                                <div>
                                    <strong class="d-block fs-5 text-dark">Nền tảng & Tư duy</strong>
                                    <p class="text-muted">Làm quen với các khái niệm cơ bản và thiết lập môi trường.</p>
                                </div>
                            </div>
                            <div class="syllabus-item">
                                <span>02</span>
                                <div>
                                    <strong class="d-block fs-5 text-dark">Xây dựng Logic nghiệp vụ</strong>
                                    <p class="text-muted">Xử lý dữ liệu và cấu trúc mã nguồn chuyên nghiệp.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="detail-sidebar">
                    <div class="price-box text-center mb-4">
                        <span class="text-muted text-uppercase small fw-bold">Học phí trọn gói</span>
                        <strong>@Model.Price.ToString("N0") VND</strong>
                    </div>
                    
              <form asp-controller="Enrollment" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.CourseId" />

                    <button type="submit" class="btn btn-primary btn-lg w-100">
                       🎓 Đăng ký học ngay
                    </button>
               </form>
                    
                    <a class="btn btn-outline-secondary w-100 border-2 fw-bold" style="border-radius: 12px;" 
                       asp-controller="Course" asp-action="Index">
                       XEM KHÓA HỌC KHÁC
                    </a>

                    <div class="mentor-box mt-5 p-3 rounded-4" style="background: #fafafa; border: 1px dashed #ddd;">
                        <h5 class="fw-bold small text-uppercase mb-3">Cam kết từ TMMDEV</h5>
                        <ul class="list-unstyled mb-0" style="font-size: 0.9rem;">
                            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Hỗ trợ sửa lỗi 1-1</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Cập nhật kiến thức mới nhất</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Truy cập tài liệu trọn đời</li>
                        </ul>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>
