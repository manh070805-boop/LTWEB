@model qlkh.Models.Schedule

@{
    ViewData["Title"] = "Chi tiết lịch học";
    string GetDayName(int d) => d == 0 ? "Chủ Nhật" : "Thứ " + (d + 1);
    
    var startTime = Model.StartTime.ToString(@"hh\:mm");
    var endTime = Model.EndTime.ToString(@"hh\:mm");
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Chi tiết lịch học</h1>
        <p>Thời khóa biểu lớp <span class="td-mono">@Model.CenterClass?.ClassName</span></p>
    </div>
    <div style="display:flex;gap:.625rem;">
        <a asp-action="Edit" asp-route-id="@Model.ScheduleId" class="btn btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Quay lại
        </a>
    </div>
</div>

<div class="details-grid">
    <div class="details-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Thông tin thời gian & địa điểm</div>
            </div>
            <div class="card-body">
                <div class="schedule-hero">
                    <div class="hero-item">
                        <label>Ngày học</label>
                        <div class="value">@GetDayName(Model.DayOfWeek)</div>
                    </div>
                    <div class="hero-divider"></div>
                    <div class="hero-item">
                        <label>Khung giờ</label>
                        <div class="value">@startTime — @endTime</div>
                    </div>
                    <div class="hero-divider"></div>
                    <div class="hero-item">
                        <label>Phòng học</label>
                        <div class="value">@(string.IsNullOrEmpty(Model.RoomName) ? "TBA" : Model.RoomName)</div>
                    </div>
                </div>

                <div class="info-grid-modern mt-4">
                    <div class="info-item-modern">
                        <label>ID Lịch học</label>
                        <div class="value td-mono">#@Model.ScheduleId</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Mã lớp học</label>
                        <div class="value td-mono">@Model.ClassId</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <div class="card-title">Ghi chú & Hướng dẫn</div>
            </div>
            <div class="card-body">
                <p style="color:var(--text-500); font-size:.875rem; line-height:1.6;">
                    Lịch học này được áp dụng cố định hàng tuần cho lớp <strong>@Model.CenterClass?.ClassName</strong>. 
                    Mọi thay đổi về lịch học tạm thời (nghỉ lễ, đổi phòng đột xuất) nên được thông báo trực tiếp cho học viên để đảm bảo thông tin chính xác.
                </p>
            </div>
        </div>
    </div>

    <div class="details-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Thông tin lớp học</div>
            </div>
            <div class="card-body">
                <div class="class-brief">
                    <div class="brief-item">
                        <label>Khóa học</label>
                        <strong>@Model.CenterClass?.Course?.CourseName</strong>
                    </div>
                    <div class="brief-item mt-3">
                        <label>Giảng viên</label>
                        <div style="display:flex; align-items:center; gap:.75rem; margin-top:.25rem;">
                            <div class="avatar-sm">@Model.CenterClass?.Teacher?.Account?.FullName?[0]</div>
                            <span style="font-weight:600; color:var(--text-900);">@Model.CenterClass?.Teacher?.Account?.FullName</span>
                        </div>
                    </div>
                </div>
                
                <hr style="border:0; border-top:1px solid var(--border); margin:1.5rem 0;">
                
                <a asp-controller="Classes" asp-action="Details" asp-route-id="@Model.ClassId" class="btn btn-outline" style="width:100%; justify-content:center; text-decoration:none;">
                    Xem chi tiết lớp học
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .details-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
    }

    .schedule-hero {
        display: flex;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        align-items: center;
    }

    .hero-item {
        flex: 1;
        text-align: center;
    }

    .hero-item label {
        display: block;
        font-size: .6875rem;
        font-weight: 600;
        color: var(--text-500);
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: .5rem;
    }

    .hero-item .value {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary-700);
    }

    .hero-divider {
        width: 1px;
        height: 40px;
        background: var(--border);
        margin: 0 1rem;
    }

    .info-grid-modern {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .info-item-modern label {
        display: block;
        font-size: .6875rem;
        font-weight: 600;
        color: var(--text-400);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .375rem;
    }

    .info-item-modern .value {
        font-size: .9375rem;
        color: var(--text-900);
        font-weight: 500;
    }

    .class-brief label {
        display: block;
        font-size: .75rem;
        color: var(--text-500);
        margin-bottom: .25rem;
    }

    .class-brief strong {
        color: var(--text-900);
        font-size: .9375rem;
    }

    .avatar-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--primary-100);
        color: var(--primary-700);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .875rem;
    }

    .btn-outline {
        background: white;
        border: 1px solid var(--border);
        color: var(--text-700);
        font-size: .8125rem;
        font-weight: 600;
        padding: .625rem 1rem;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        transition: all .2s;
    }
    .btn-outline:hover { background: var(--bg); border-color: var(--text-300); }

    @@media (max-width: 1024px) {
        .details-grid { grid-template-columns: 1fr; }
        .schedule-hero { flex-direction: column; gap: 1.5rem; }
        .hero-divider { width: 100%; height: 1px; margin: 0; }
    }
</style>
