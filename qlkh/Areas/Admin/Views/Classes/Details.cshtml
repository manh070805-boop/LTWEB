@model qlkh.Models.CenterClass

@{
    ViewData["Title"] = "Chi tiết lớp học";
    var badgeClass = Model.StatusId == 1 ? "badge-warning" :
                     Model.StatusId == 2 ? "badge-success" :
                     Model.StatusId == 3 ? "badge-neutral" : "badge-danger";
    
    var currentStudents = Model.Enrollments.Count;
    var maxStudents = Model.MaxStudents ?? 0;
    var occupancyRate = maxStudents > 0 ? (double)currentStudents / maxStudents * 100 : 0;
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Quản lý lớp học</h1>
        <p>@Model.ClassName • Mã lớp: <span class="td-mono">#@Model.ClassId</span></p>
    </div>
    <div style="display:flex;gap:.625rem;">
        <a asp-action="Edit" asp-route-id="@Model.ClassId" class="btn btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Quay lại
        </a>
    </div>
</div>

<div class="details-grid">
    <div class="details-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Thông tin chung</div>
                <span class="badge @badgeClass">@Model.Status?.StatusName</span>
            </div>
            <div class="card-body">
                <div class="info-grid-modern">
                    <div class="info-item-modern">
                        <label>Khóa học</label>
                        <div class="value">@Model.Course?.CourseName</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Phòng học</label>
                        <div class="value">@Model.RoomName</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Ngày bắt đầu</label>
                        <div class="value">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "—")</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Ngày kết thúc</label>
                        <div class="value">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "—")</div>
                    </div>
                    <div class="info-item-modern">
                        <label>Sĩ số hiện tại</label>
                        <div class="value">@currentStudents / @(maxStudents > 0 ? maxStudents.ToString() : "∞")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <div class="card-title">Danh sách học viên</div>
                <span class="badge badge-neutral">@currentStudents thành viên</span>
            </div>
            <div class="card-body" style="padding:0;">
                <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Học viên</th>
                                <th>Email / SĐT</th>
                                <th>Ngày tham gia</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var en in Model.Enrollments)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:600;color:var(--text-900);">@en.Student?.Account?.FullName</div>
                                        <div style="font-size:.75rem;color:var(--text-500);">ID: @en.StudentId</div>
                                    </td>
                                    <td>
                                        <div style="font-size:.875rem;">@en.Student?.Account?.Email</div>
                                        <div style="font-size:.75rem;color:var(--text-500);">@en.Student?.Phone</div>
                                    </td>
                                    <td class="text-sm">@en.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-controller="Students" asp-action="Details" asp-route-id="@en.StudentId" class="btn-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Enrollments.Any())
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center;padding:2.5rem;color:var(--text-400);">Lớp học này hiện chưa có học viên đăng ký.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="details-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Tỉ lệ lấp đầy</div>
            </div>
            <div class="card-body">
                <div class="capacity-gauge">
                    <div class="gauge-header">
                        <span class="percentage">@occupancyRate.ToString("0")%</span>
                        <span class="label">Đã đăng ký</span>
                    </div>
                    <div class="progress-track">
                        <div class="progress-bar" style="width: @(occupancyRate)%"></div>
                    </div>
                    <div class="gauge-footer">
                        <span>@currentStudents học viên</span>
                        <span>Tối đa @(maxStudents > 0 ? maxStudents.ToString() : "∞")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <div class="card-title">Giảng viên phụ trách</div>
            </div>
            <div class="card-body">
                <div class="teacher-brief-card">
                    <div class="avatar-simple">@Model.Teacher?.Account?.FullName?[0]</div>
                    <div class="teacher-info">
                        <strong>@Model.Teacher?.Account?.FullName</strong>
                        <span class="specialization">@Model.Teacher?.Specialization</span>
                    </div>
                </div>
                <div style="margin-top:1.25rem; display:flex; flex-direction:column; gap:.5rem;">
                    <a asp-controller="Teachers" asp-action="Details" asp-route-id="@Model.TeacherId" class="btn btn-outline" style="justify-content:center; text-decoration:none;">
                        Hồ sơ giảng viên
                    </a>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <div class="card-title">Hoạt động lớp</div>
            </div>
            <div class="card-body">
                <div class="timeline-simple">
                    <div class="timeline-item">
                        <div class="timeline-point"></div>
                        <div class="timeline-content">
                            <label>Khởi tạo lớp học</label>
                            <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .details-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
    }

    .info-grid-modern {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .info-item-modern label {
        display: block;
        font-size: .6875rem;
        font-weight: 600;
        color: var(--text-400);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .375rem;
    }

    .info-item-modern .value {
        font-size: .9375rem;
        color: var(--text-900);
        font-weight: 500;
    }

    /* Capacity Gauge */
    .capacity-gauge {
        padding: .5rem 0;
    }

    .gauge-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: .75rem;
    }

    .gauge-header .percentage {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--primary);
    }

    .gauge-header .label {
        font-size: .8125rem;
        color: var(--text-500);
        font-weight: 500;
    }

    .progress-track {
        height: 10px;
        background: var(--bg);
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .progress-bar {
        height: 100%;
        background: var(--primary);
        border-radius: 10px;
        transition: width .6s ease;
    }

    .gauge-footer {
        display: flex;
        justify-content: space-between;
        margin-top: .75rem;
        font-size: .75rem;
        color: var(--text-400);
        font-weight: 500;
    }

    /* Teacher Card */
    .teacher-brief-card {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .avatar-simple {
        width: 44px;
        height: 44px;
        background: var(--primary-100);
        color: var(--primary-700);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.25rem;
    }

    .teacher-info strong {
        display: block;
        font-size: .9375rem;
        color: var(--text-900);
    }

    .teacher-info .specialization {
        font-size: .75rem;
        color: var(--text-500);
    }

    .btn-outline {
        background: white;
        border: 1px solid var(--border);
        color: var(--text-700);
        font-size: .8125rem;
        font-weight: 600;
        padding: .625rem 1rem;
        border-radius: var(--radius-sm);
        transition: all .2s;
    }

    .btn-outline:hover {
        background: var(--bg);
        border-color: var(--text-300);
    }

    @@media (max-width: 1024px) {
        .details-grid { grid-template-columns: 1fr; }
    }
</style>
