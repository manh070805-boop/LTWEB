@model IEnumerable<qlkh.Models.Enrollment>

@{
    ViewData["Title"] = "Quản lý đăng ký học";

    string EnrollBadge(int? statusId) => statusId switch
    {
        1 => "badge-warning",
        2 => "badge-success",
        3 => "badge-danger",
        _ => "badge-neutral"
    };
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Danh sách đăng ký học</h1>
        <p>Quản lý ghi danh học viên vào khóa học</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px"><polyline points="20 6 9 17 4 12"/></svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        @TempData["ErrorMessage"]
    </div>
}

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Ngày đăng ký</th>
                <th>Học viên</th>
                <th>Khóa học</th>
                <th>Lớp học</th>
                <th>Trạng thái</th>
                <th style="width:180px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="td-mono">@item.EnrollmentId</td>
                    <td class="text-muted text-sm">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="font-weight:500;color:var(--text-900);">@item.Student?.Account?.FullName</td>
                    <td class="text-muted">@item.Course?.CourseName</td>
                    <td>@(item.CenterClass != null ? item.CenterClass.ClassName : "—")</td>
                    <td><span class="badge @EnrollBadge(item.StatusId)">@item.EnrollmentStatus?.StatusName</span></td>
                    <td>
                        <div style="display:flex;gap:.375rem;">
                            <a asp-action="Details" asp-route-id="@item.EnrollmentId" class="btn btn-info btn-sm">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.EnrollmentId" class="btn btn-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.EnrollmentId" class="btn btn-danger btn-sm">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" style="text-align:center;padding:3rem;color:var(--text-400);">Chưa có đăng ký nào</td></tr>
            }
        </tbody>
    </table>
</div>
