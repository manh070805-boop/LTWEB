@model qlkh.Areas.Admin.ViewModels.AccountFormViewModel

@{
    ViewData["Title"] = "Thêm tài khoản";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Thêm tài khoản mới</h1>
        <p>Tạo tài khoản và phân quyền truy cập hệ thống</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Quay lại
    </a>
</div>

<div class="edit-grid animate-in">
    <div class="edit-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Thông tin tài khoản</div>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="validation-summary"></div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" />
                            <span asp-validation-for="Username" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password" class="form-label">Mật khẩu</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Nhập mật khẩu" />
                            <span asp-validation-for="Password" class="form-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Họ và tên đầy đủ" />
                        <span asp-validation-for="FullName" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Địa chỉ Email</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" />
                        <span asp-validation-for="Email" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RoleId" class="form-label">Phân quyền</label>
                        <select asp-for="RoleId" asp-items="ViewBag.RoleId" class="form-select">
                            <option value="">-- Chọn quyền --</option>
                        </select>
                        <span asp-validation-for="RoleId" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <span class="form-check-label">Kích hoạt tài khoản ngay</span>
                        </label>
                    </div>

                    <div style="display:flex;gap:.75rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                            </svg>
                            Tạo tài khoản
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="edit-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Quy tắc bảo mật</div>
            </div>
            <div class="card-body">
                <ul class="guide-list">
                    <li>
                        <strong>Định dạng:</strong> Tên đăng nhập nên viết liền, không dấu và không chứa ký tự đặc biệt.
                    </li>
                    <li>
                        <strong>Mật khẩu:</strong> Sử dụng tối thiểu 8 ký tự, bao gồm chữ hoa, chữ thường và số để tăng tính bảo mật.
                    </li>
                    <li>
                        <strong>Email:</strong> Email sẽ được sử dụng để khôi phục mật khẩu và nhận thông báo hệ thống quan trọng.
                    </li>
                    <li>
                        <strong>Phân quyền:</strong> Cẩn trọng khi cấp quyền "Admin" cho người dùng mới vì họ sẽ có toàn quyền kiểm soát.
                    </li>
                </ul>
            </div>
        </div>

        <div class="card" style="background: var(--info-bg); border-color: #93c5fd;">
            <div class="card-body">
                <div style="display:flex; gap:1rem; align-items:flex-start;">
                    <div style="font-size:1.5rem;">🛡️</div>
                    <div>
                        <h4 style="margin:0 0 .25rem 0; font-size:.875rem; color:var(--info-text);">Bảo mật hệ thống</h4>
                        <p style="margin:0; font-size:.8125rem; color:var(--info-text); opacity:0.8; line-height:1.4;">
                            Mọi thao tác tạo tài khoản đều được ghi lại trong nhật ký hoạt động để đảm bảo tính minh bạch.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
