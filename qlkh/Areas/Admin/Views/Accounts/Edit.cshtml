@model qlkh.Areas.Admin.ViewModels.AccountFormViewModel

@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Cập nhật tài khoản</h1>
        <p>Chỉnh sửa thông tin và quyền truy cập</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Quay lại
    </a>
</div>

<div class="edit-grid">
    <div class="edit-main">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Cấu hình tài khoản</div>
                <span class="badge badge-neutral">Mã định danh: @Model.AccountId</span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AccountId" />

                    <div asp-validation-summary="All" class="validation-summary"></div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control" placeholder="Ví dụ: admin_01" />
                            <span asp-validation-for="Username" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password" class="form-label">Mật khẩu mới</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Để trống nếu không đổi" />
                            <span asp-validation-for="Password" class="form-error"></span>
                            <div class="form-hint" style="font-size: .75rem; color: var(--text-400); margin-top: .25rem;">
                                Chỉ nhập nếu bạn muốn đặt lại mật khẩu cho người dùng này.
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập tên đầy đủ..." />
                        <span asp-validation-for="FullName" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Địa chỉ Email</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="example@domain.com" />
                        <span asp-validation-for="Email" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RoleId" class="form-label">Phân quyền hệ thống</label>
                        <select asp-for="RoleId" asp-items="ViewBag.RoleId" class="form-select">
                            <option value="">-- Chọn nhóm quyền --</option>
                        </select>
                        <span asp-validation-for="RoleId" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <span class="form-check-label">Cho phép đăng nhập (Trạng thái hoạt động)</span>
                        </label>
                    </div>

                    <div style="display:flex;gap:.75rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                            </svg>
                            Cập nhật tài khoản
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="edit-sidebar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">An ninh & Bảo mật</div>
            </div>
            <div class="card-body">
                <ul class="guide-list">
                    <li>
                        <strong>Chính sách mật khẩu:</strong> Mật khẩu mới nên có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và số.
                    </li>
                    <li>
                        <strong>Quyền truy cập:</strong> Hãy thận trọng khi cấp quyền <em>Quản trị viên</em> (Admin) vì họ có toàn quyền thay đổi hệ thống.
                    </li>
                    <li>
                        <strong>Email:</strong> Phải là email duy nhất để nhận các thông báo quan trọng từ hệ thống.
                    </li>
                </ul>
            </div>
        </div>

        <div class="card mt-4" style="background: var(--primary-50); border-color: var(--primary-100);">
            <div class="card-body">
                <div style="display:flex; gap:1rem; align-items:flex-start;">
                    <div style="font-size:1.5rem;">🛡️</div>
                    <div>
                        <h4 style="margin:0 0 .25rem 0; font-size:.875rem; color:var(--primary-700);">Kiểm soát truy cập</h4>
                        <p style="margin:0; font-size:.8125rem; color:var(--primary-600); line-height:1.4;">
                            Nếu tài khoản này có dấu hiệu bị xâm nhập, hãy bỏ chọn <strong>"Cho phép đăng nhập"</strong> ngay lập tức để tạm khóa quyền truy cập.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .edit-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .guide-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .guide-list li {
        font-size: .875rem;
        color: var(--text-600);
        line-height: 1.5;
        position: relative;
        padding-left: 1.25rem;
    }

    .guide-list li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--primary);
        font-weight: bold;
    }

    .guide-list li strong {
        color: var(--text-900);
        display: block;
        margin-bottom: .125rem;
    }

    @@media (max-width: 1024px) {
        .edit-grid { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
