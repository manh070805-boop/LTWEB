<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trung Tâm Lập Trình</title>

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="grain-texture">
    <div id="top-loading-bar"></div>

<div class="admin-shell">

    <!-- Mobile overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <partial name="_AdminSidebar" />
    </aside>

    <!-- Main -->
    <div class="admin-main">

        <!-- Topbar -->
        <header class="admin-topbar">
            <div class="flex items-center gap-3">
                <button class="burger-btn" onclick="openSidebar()" aria-label="Mở menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <line x1="3" y1="12" x2="21" y2="12"/>
                        <line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                </button>
                <span class="admin-topbar-title">@ViewData["Title"]</span>
            </div>

            <div class="admin-topbar-right">
                <span class="admin-topbar-greeting">
                    Xin chào, <strong>@Context.Session.GetString("FullName")</strong>
                </span>
                <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-secondary btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Đăng xuất
                </a>
            </div>
        </header>

        <!-- Content -->
        <main class="admin-content">
            @RenderBody()
        </main>

    </div>
</div>

<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script>lucide.createIcons();</script>

<script>
    function openSidebar() {
        document.getElementById('adminSidebar').classList.add('open');
        document.getElementById('sidebarOverlay').classList.add('open');
    }
    function closeSidebar() {
        document.getElementById('adminSidebar').classList.remove('open');
        document.getElementById('sidebarOverlay').classList.remove('open');
    }

    // Active nav highlighting
    document.addEventListener('DOMContentLoaded', function () {
        const bar = document.getElementById('top-loading-bar');
        
        // Finish loading
        setTimeout(() => {
            bar.classList.add('finished');
        }, 100);

        // Intercept links for loading bar
        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href && !href.startsWith('#') && !href.startsWith('javascript') && this.target !== '_blank') {
                    bar.classList.remove('finished');
                    bar.classList.add('loading');
                }
            });
        });

        const links = document.querySelectorAll('.sidebar-nav-item');
        const current = window.location.pathname.toLowerCase();
        links.forEach(function (link) {
            const href = link.getAttribute('href');
            if (href && current.includes(href.toLowerCase().split('/').filter(Boolean)[1] || '')) {
                // handled by server-side class
            }
        });
        lucide.createIcons();
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
